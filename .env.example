# Render/runtime persistence
ABUTMENTIQ_DATA_ROOT=/var/data/abutmentiq

# Human access (always required outside explicit local demo mode)
ABUTMENTIQ_APP_USERNAME=
ABUTMENTIQ_APP_PASSWORD=
# Exact canonical browser origin; required in production (no trailing path):
ABUTMENTIQ_ALLOWED_ORIGIN=https://your-service.onrender.com
# Development on loopback only; never set this in Render:
# ABUTMENTIQ_LOCAL_DEMO=true

# Scanner bridge upload credential
ABUTMENTIQ_PLATFORM_INGEST_TOKEN=
ABUTMENTIQ_PLATFORM_MAX_BYTES=104857600

# Private identity vault: Fernet key generated with Fernet.generate_key()
ABUTMENTIQ_IDENTITY_ENCRYPTION_KEY=
